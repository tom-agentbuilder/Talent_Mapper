{
  "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "apify": {
            "type": "local",
            "enabled": true,
            "command": "npx",
            "args": [
                "-y",
                "@apify/mcp-server"
            ],
            "env": {
                "APIFY_TOKEN": "${APIFY_TOKEN}"
            }
        }
    }
}